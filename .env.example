# Copy to .env to use MySQL 8.4 (docker compose up -d).
# If this variable is unset, the API uses a local SQLite file so it can run
# before MySQL is installed. The schema is the same either way.
DATABASE_URL=mysql+pymysql://gridline:gridline@127.0.0.1:3306/substation?charset=utf8mb4
JWT_SECRET=change-me-before-any-shared-environment
